{
  "name": "app-clima",
  "private": true,
  "version": "1.0.0",
  "description": "Aplicación meteorológica accesible con React y un proxy seguro para OpenWeather.",
  "type": "module",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names API,WEB --prefix-colors magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch --env-file-if-exists=.env server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/start-production.js",
    "preview": "npm run build && npm start",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "prop-types": "^15.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "supertest": "^7.3.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
